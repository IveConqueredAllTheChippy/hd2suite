// resources of "HD2 Mod Tools.exe": icon, version information, manifest
#include <winver.h>
1 ICON "icon.ico"
1 24 "launcher.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,2,0
PRODUCTVERSION 0,3,2,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "ProductName", "HD2 Mod Tools (hd2suite)"
      VALUE "FileDescription", "HD2 Mod Tools launcher - starts hd2suite\\app.py with Python"
      VALUE "FileVersion", "0.3.2"
      VALUE "ProductVersion", "0.3.2"
      VALUE "InternalName", "launcher"
      VALUE "OriginalFilename", "HD2 Mod Tools.exe"
      VALUE "Comments", "Unofficial fan-made tool. Not affiliated with Arrowhead Game Studios or Sony. Source code: launcher\\launcher.c next to this file."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
